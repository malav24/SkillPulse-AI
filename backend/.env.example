# Copy to backend/.env and adjust. Every value is optional.

# Database: SQLite by default; PostgreSQL also works.
# DATABASE_URL=sqlite:///./storage/skillpulse.db
# DATABASE_URL=postgresql+psycopg2://skillpulse:skillpulse@localhost:5432/skillpulse

# Syllabus uploads
MAX_UPLOAD_MB=20
# UPLOAD_DIR=./storage/uploads

# Scanned PDFs need Tesseract OCR installed (see README)
OCR_ENABLED=true
# Windows example: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Trained models + market index (built by: python -m ml.train_all)
# ARTIFACTS_DIR=./artifacts

# Better matching of related skills (optional; needs `pip install -r requirements-optional.txt`)
SEMANTIC_ENABLED=true
